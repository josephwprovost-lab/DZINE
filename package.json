{
  "name": "dzine-mcp",
  "version": "1.0.0",
  "description": "MCP server for DZINE AI - Browser automation with Playwright",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dzine-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "login": "node dist/login.js",
    "prepare": "npm run build",
    "postinstall": "npx playwright install chromium"
  },
  "keywords": [
    "mcp",
    "dzine",
    "ai",
    "image-generation",
    "text-to-image",
    "style-transfer",
    "playwright",
    "browser-automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
